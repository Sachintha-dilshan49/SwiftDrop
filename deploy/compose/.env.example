# Copy this file to deploy/compose/.env and fill in real values.
# NEVER commit .env to git (enforced by .gitignore and project rules).
# Every environment variable a service reads is listed here with a dummy or local development value.
# See docs/conventions.md §4 for naming conventions (<SERVICE>_<THING>).

# ─── Security / Auth ──────────────────────────────────────────────────────────
# auth-service JWKS endpoint used to verify access tokens (api-gateway and every service).
# Called directly on the internal Docker network, not through the gateway.
# Locally without Docker the default is http://localhost:8081/.well-known/jwks.json
JWT_JWK_SET_URI=http://auth-service:8081/.well-known/jwks.json
# A 2048-bit RSA private key in PKCS#8 DER form, base64-encoded on one line. Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 | tr -d '\n'
# (genpkey -outform DER alone writes PKCS#1 on OpenSSL 3, which auth-service rejects at startup.)
# See docs/auth-service.md. Never use a committed key or share this value.
JWT_PRIVATE_KEY_B64=replace-with-base64-encoded-pkcs8-private-key
JWT_KEY_ID=swiftdrop-auth-1
JWT_ISSUER=swiftdrop-auth

# Shared secret for service-to-service calls to /internal/** (header X-Internal-Token, ADR-010).
# Every servlet service (all except api-gateway) needs the SAME value and refuses to start without it.
# Generate a real one with: openssl rand -hex 32
INTERNAL_API_TOKEN=replace-me-with-openssl-rand-hex-32-output

# ─── Auth Service Database (auth_db) ──────────────────────────────────────────
# Role 2 (Thulani): User accounts, BCrypt passwords, refresh tokens, OAuth links
AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_db
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_pass

# ─── Pricing Service Database (pricing_db) ────────────────────────────────────
# Role 1 (Sachintha): Delivery zones, pricing rules, rate calculations
PRICING_DB_URL=jdbc:postgresql://postgres:5432/pricing_db
PRICING_DB_USER=pricing
PRICING_DB_PASSWORD=pricing_pass

# ─── Parcel Service Database (parcel_db) ──────────────────────────────────────
# Role 3 (Pamudi): Parcels, tracking numbers, status history, transactional outbox
PARCEL_DB_URL=jdbc:postgresql://postgres:5432/parcel_db
PARCEL_DB_USER=parcel
PARCEL_DB_PASSWORD=parcel_pass

# ─── Dispatch Service Database (dispatch_db) ──────────────────────────────────
# Role 4 (Tharuki): Couriers, delivery assignments, proof references, daily stats
DISPATCH_DB_URL=jdbc:postgresql://postgres:5432/dispatch_db
DISPATCH_DB_USER=dispatch
DISPATCH_DB_PASSWORD=dispatch_pass

# ─── Merchant Service Database (merchant_db) ──────────────────────────────────
# Role 5 (Shenal): Merchant profiles, API keys, webhook endpoint configs
MERCHANT_DB_URL=jdbc:postgresql://postgres:5432/merchant_db
MERCHANT_DB_USER=merchant
MERCHANT_DB_PASSWORD=merchant_pass

# ─── Notification Service Database (notification_db) ──────────────────────────
# Role 6 (Thisaru): Notifications history, webhook delivery attempts, idempotency
NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/notification_db
NOTIFICATION_DB_USERNAME=notif
NOTIFICATION_DB_PASSWORD=notif_pass

# ─── RabbitMQ (Message Broker) ────────────────────────────────────────────────
# Used for asynchronous parcel status events (topic exchange: parcel.events)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ─── Redis (Cache & Rate Limiting) ────────────────────────────────────────────
# Used by api-gateway (Role 1) for rate limiting (Spring Cloud Gateway RedisRateLimiter).
# If Redis is down the limiter fails open (requests pass).
REDIS_HOST=redis
REDIS_PORT=6379

# ─── MinIO (S3-Compatible Object Storage) ─────────────────────────────────────
# Used by dispatch-service (Role 4) for storing delivery proof photos
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DELIVERY_PROOFS=delivery-proofs

# ─── Mail (Mailpit for local development / testing) ───────────────────────────
# Used by notification-service (Role 6) for customer email alerts and by auth-service for password reset emails
MAIL_HOST=mailpit
MAIL_PORT=1025
NOTIFICATION_FROM_EMAIL=noreply@swiftdrop.lk

# ─── Tracking URL ─────────────────────────────────────────────────────────────
# Base URL for parcel tracking links included in email/SMS notifications
TRACKING_BASE_URL=http://localhost:3000/track

# ─── Internal Service URLs (Inter-service HTTP calls) ──────────────────────────
# Direct service-to-service communication on the internal network (not routed via gateway).
# api-gateway also uses all of these as its route targets.
AUTH_SERVICE_URL=http://auth-service:8081
MERCHANT_SERVICE_URL=http://merchant-service:8085
PARCEL_SERVICE_URL=http://parcel-service:8083
PRICING_SERVICE_URL=http://pricing-service:8082
DISPATCH_SERVICE_URL=http://dispatch-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8086
AI_ASSISTANT_URL=http://ai-assistant:8087

# ─── API Gateway (api-gateway, Role 1) ─────────────────────────────────────────
# Browser origins allowed by CORS, comma-separated (nginx frontend and Vite dev server)
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# HTTP client timeouts to services: connect in milliseconds, response as a duration (SSE has none)
GATEWAY_HTTP_CONNECT_TIMEOUT_MS=2000
GATEWAY_HTTP_RESPONSE_TIMEOUT=10s
# Merchant API rate limit per X-API-Key: tokens per second and burst size
GATEWAY_MERCHANT_RATE_LIMIT_REPLENISH=10
GATEWAY_MERCHANT_RATE_LIMIT_BURST=20
# Public fee estimate rate limit per client IP: tokens per second and burst size
GATEWAY_ESTIMATE_RATE_LIMIT_REPLENISH=5
GATEWAY_ESTIMATE_RATE_LIMIT_BURST=20
# AI assistant chat rate limit per signed-in user. Each message costs TOKENS_PER_MESSAGE tokens; the bucket refills
# REPLENISH tokens per second up to BURST. Defaults: 5 messages at once, then one every 6 seconds.
GATEWAY_ASSISTANT_RATE_LIMIT_REPLENISH=1
GATEWAY_ASSISTANT_RATE_LIMIT_BURST=30
GATEWAY_ASSISTANT_RATE_LIMIT_TOKENS_PER_MESSAGE=6

# ─── Demo accounts (auth-service) ─────────────────────────────────────────────
# Demo staff accounts for local runs and demos: demo.admin@, demo.dispatcher@ and demo.courier@swiftdrop.example.com,
# all with this password (at least 12 characters). Leave empty to create none; never set it in production.
AUTH_DEMO_ACCOUNTS_PASSWORD=

# Password reset (auth-service). The emailed link opens this frontend page with ?token=...
AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password
AUTH_FROM_EMAIL=noreply@swiftdrop.lk
# Demo only: when set, accounts with no password reset address get this one (users.password_reset_email),
# so every reset email goes to one inbox. Leave empty to send each reset email to the account's own email.
AUTH_PASSWORD_RESET_DEFAULT_EMAIL=

# ─── Google OAuth 2.0 (auth-service) ──────────────────────────────────────────
# Set AUTH_GOOGLE_ENABLED=true after configuring the OAuth client in Google Cloud.
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=your-google-client-id
AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
# In the Google OAuth client, add the authorized redirect URI http://localhost:3000/login/oauth2/code/google
# (http://localhost:5173/login/oauth2/code/google for the Vite dev server). Google login goes through the gateway.
# Where the app opens after a Google login; for the Vite dev server use http://localhost:5173/auth/callback.
AUTH_OAUTH_SUCCESS_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── Frontend Configuration ───────────────────────────────────────────────────
# Frontend API requests use nginx's /api proxy, or Vite's local dev proxy.
VITE_API_BASE_URL=/api
VITE_GOOGLE_LOGIN_ENABLED=false

# ─── AI Assistant ─────────────────────────────────────────────────────────────
# Role 9 (Devmith): the assistant's tools call the public API through the gateway with the user's JWT
GATEWAY_URL=http://api-gateway:8080
# Default model: Groq (OpenAI-compatible). Free key at console.groq.com.
# Left empty, the service still starts and chat answers 503 "not configured".
AI_DEFAULT_MODEL=groq
AI_GROQ_API_KEY=
AI_GROQ_MODEL=openai/gpt-oss-120b
# Optional second model: any OpenAI-compatible API
AI_OPENAI_ENABLED=false
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4.1-mini
