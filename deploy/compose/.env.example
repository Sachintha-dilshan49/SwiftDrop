# Copy to deploy/compose/.env and fill in real values. Never commit .env.
# Every variable a service reads is listed here with a dummy or local value (conventions.md §4).

# --- Security (all services except api-gateway) ---
# auth-service JWKS used to verify access tokens. Called directly on the internal network,
# not through the gateway. Locally without Docker the default is http://localhost:8081/.well-known/jwks.json
JWT_JWK_SET_URI=http://auth-service:8081/.well-known/jwks.json

# --- dispatch-service (Role 4) ---
# Own database only (ADR-008). Locally without Docker the URL default is jdbc:postgresql://localhost:5432/dispatch_db
DISPATCH_DB_URL=jdbc:postgresql://postgres:5432/dispatch_db
DISPATCH_DB_USER=dispatch
DISPATCH_DB_PASSWORD=change-me
