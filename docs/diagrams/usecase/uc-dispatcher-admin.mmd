%% Use case — Dispatcher and Admin
%% Source: docs/architecture.md v1.1 §5, §6.3 webhook retry, §7, §9 · Role 1
%% Admin specialises Dispatcher: an Admin can do everything a Dispatcher can, plus the admin-only use cases.
flowchart LR
  classDef actor fill:#ffffff,stroke:#222,stroke-width:2px,font-weight:bold
  classDef uc fill:#ffffff,stroke:#444
  classDef note fill:#fffbe6,stroke:#c9a400,font-size:12px

  Dispatcher["«actor»<br/>Dispatcher<br/>(DISPATCHER role)"]:::actor
  Admin["«actor»<br/>Admin<br/>(ADMIN role)"]:::actor
  Admin -- "generalises" --> Dispatcher

  subgraph DISP["Dispatcher use cases"]
    direction TB
    D1(["View unassigned parcels<br/>GET /dispatch/unassigned"]):::uc
    D2(["Assign parcel to courier<br/>POST /dispatch/assignments"]):::uc
    D3(["View courier workload<br/>GET /dispatch/workload"]):::uc
    D4(["View daily reports<br/>GET /reports/daily"]):::uc
    D5(["View all parcels and history"]):::uc
    D6(["Update status on behalf of a courier"]):::uc
    D7(["View webhook deliveries<br/>GET /admin/webhook-deliveries"]):::uc
    D8(["Replay parked webhook<br/>POST /admin/webhook-deliveries/{id}/replay"]):::uc
  end

  subgraph ADM["Admin-only use cases"]
    direction TB
    A1(["Approve / reject merchants<br/>/admin/merchants"]):::uc
    A2(["Manage users and roles<br/>/admin/users"]):::uc
    A3(["Manage zones<br/>/admin/zones"]):::uc
    A4(["Manage pricing rules and promo codes<br/>/admin/pricing-rules"]):::uc
  end

  Dispatcher --- D1 & D2 & D3 & D4 & D5 & D6 & D7
  D8 -. "«extend»<br/>[delivery PARKED]" .-> D7
  D2 -. "«include»" .-> D3
  Admin --- A1 & A2 & A3 & A4

  N1["All routes are /api/v1/... through the gateway.<br/>Role checks with @PreAuthorize in each service."]:::note
  D4 ~~~ N1
