%% Use case — SwiftDrop system overview (all actors)
%% Source: docs/architecture.md v1.1 §1, §5, §9 · Role 1
%% Detail per actor: uc-guest, UC-00_customer_overview (Role 7), uc-merchant, uc-courier, uc-dispatcher-admin
%% Admin specialises Dispatcher: an Admin also performs every Dispatcher use case.
flowchart LR
  classDef actor fill:#ffffff,stroke:#222,stroke-width:2px,font-weight:bold
  classDef ext fill:#f2f2f2,stroke:#777,stroke-dasharray:5 3
  classDef uc fill:#ffffff,stroke:#444

  Guest["«actor»<br/>Guest<br/>(not logged in)"]:::actor
  Customer["«actor»<br/>Customer"]:::actor
  Merchant["«actor»<br/>Merchant"]:::actor
  Courier["«actor»<br/>Courier"]:::actor
  Dispatcher["«actor»<br/>Dispatcher"]:::actor
  Admin["«actor»<br/>Admin<br/>(+ all Dispatcher<br/>use cases)"]:::actor

  subgraph SD["SwiftDrop platform"]
    UA(["Sign up / log in (email or Google)"]):::uc
    UT(["Track parcel by tracking number (live)"]):::uc
    UE(["Get fee estimate"]):::uc
    UB(["Book a delivery"]):::uc
    UH(["View my deliveries, details and receipt"]):::uc
    UAI(["Chat with AI assistant"]):::uc
    UR(["Register business"]):::uc
    UK(["Manage API keys and webhook"]):::uc
    UMD(["View merchant orders"]):::uc
    UD(["View today's deliveries"]):::uc
    US(["Update delivery status (note, proof photo)"]):::uc
    UAS(["Assign parcels to couriers"]):::uc
    URP(["View workload and daily reports"]):::uc
    UWH(["View / replay webhook deliveries"]):::uc
    UMA(["Approve / reject merchants"]):::uc
    UU(["Manage users and roles"]):::uc
    UP(["Manage zones, pricing rules, promo codes"]):::uc
    UMO(["Create order via merchant API"]):::uc
  end

  Google["«system»<br/>Google OAuth 2.0"]:::ext
  Notify["«system»<br/>Email / SMS gateway<br/>→ customer, recipient"]:::ext
  Store["«system»<br/>Merchant store server"]:::ext

  Guest --- UA & UT & UE
  Customer --- UB & UH & UAI
  Merchant --- UR & UK & UMD
  Courier --- UD & US
  Dispatcher --- UAS & URP & UWH
  Admin --- UMA & UU & UP

  UA --- Google
  US -. "status event" .-> Notify
  UMO --- Store
  UB -. "«include»" .-> UE
