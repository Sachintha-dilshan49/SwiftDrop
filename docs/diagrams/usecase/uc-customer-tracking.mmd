%% Use case — Customer tracking, history and receipts
%% Recreated from UC-03_customer_tracking.puml by Supuni (Role 7); original kept as ../UC-03_customer_tracking-original.*
%% Fixes per docs/architecture.md v1.1 §6.3 and parcel-service design (Role 3): receipt is available for any own parcel
%% (not only DELIVERED); another customer's parcel returns 404 (not 403); SMS only on 3 statuses and goes to the recipient
flowchart LR
  classDef actor fill:#ffffff,stroke:#222,stroke-width:2px,font-weight:bold
  classDef ext fill:#f2f2f2,stroke:#777,stroke-dasharray:5 3
  classDef uc fill:#ffffff,stroke:#444
  classDef note fill:#fffbe6,stroke:#c9a400,font-size:12px

  Customer["«actor»<br/>Customer"]:::actor
  Guest["«actor»<br/>Guest<br/>(not logged in)"]:::actor

  subgraph SD["SwiftDrop platform"]
    direction TB
    C10(["View my deliveries<br/>(delivery history)"]):::uc
    C11(["View parcel details"]):::uc
    C11a(["View status history<br/>(who, when, note, proof)"]):::uc
    C13(["Download receipt (PDF)"]):::uc
    C14(["Track parcel by tracking number<br/>(public)"]):::uc
    C12(["Follow live updates<br/>(Server-Sent Events)"]):::uc
    C15(["Receive status notifications"]):::uc
  end

  Notify["«system»<br/>Email / SMS gateway"]:::ext
  Recipient["«actor»<br/>Recipient<br/>(no account)"]:::ext

  Customer --- C10 & C11 & C14
  Guest --- C14
  C11 -. "«include»" .-> C11a
  C13 -. "«extend»" .-> C11
  C12 -. "«extend»<br/>[not DELIVERED / FAILED]" .-> C14
  C15 --- Customer
  C15 --- Recipient
  C15 --- Notify

  N1["Only the owner (or Dispatcher/Admin) sees a parcel;<br/>anyone else gets 404 so IDs cannot be probed."]:::note
  N2["Public page: status and timeline only, no personal data."]:::note
  N3["Customer booking: email to the customer on every change;<br/>SMS to the recipient on OUT_FOR_DELIVERY, DELIVERED, FAILED."]:::note
  C11 ~~~ N1
  C14 ~~~ N2
  C15 ~~~ N3
