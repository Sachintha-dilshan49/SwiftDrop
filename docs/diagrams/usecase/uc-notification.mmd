%% Use case — notification-service
%% Based on usecase-notification.mmd by Thisaru Ramanayaka (Role 6); corrected against docs/architecture.md v1.1 §6.3 "Who is notified"
%% Changes: Recipient added as a separate actor; email/SMS targets depend on who booked; contact look-ups shown
flowchart LR
  classDef actor fill:#ffffff,stroke:#222,stroke-width:2px,font-weight:bold
  classDef ext fill:#f2f2f2,stroke:#777,stroke-dasharray:5 3
  classDef uc fill:#ffffff,stroke:#444

  PS["«system»<br/>parcel-service<br/>(publishes via outbox)"]:::ext
  Admin["«actor»<br/>Dispatcher / Admin"]:::actor

  subgraph NS["notification-service :8086"]
    direction TB
    U1(["Receive ParcelStatusChanged<br/>(notification.q, webhook.q)"]):::uc
    U2(["Skip duplicate eventId"]):::uc
    U3(["Look up contacts<br/>(auth, parcel, merchant /internal APIs)"]):::uc
    U4(["Send email<br/>(every status)"]):::uc
    U5(["Send SMS<br/>(OUT_FOR_DELIVERY, DELIVERED, FAILED)"]):::uc
    U6(["Send HMAC-signed webhook<br/>(merchant bookings)"]):::uc
    U7(["Retry failed webhook<br/>10 s → 1 min → 5 min → parked"]):::uc
    U8(["List webhook deliveries"]):::uc
    U9(["Replay parked webhook"]):::uc
  end

  Customer["«actor»<br/>Customer"]:::actor
  Recipient["«actor»<br/>Recipient"]:::actor
  Store["«system»<br/>Merchant store server"]:::ext

  PS -- "RabbitMQ parcel.events" --> U1
  U1 -. "«include»" .-> U2
  U1 -. "«include»" .-> U3
  U1 --> U4 & U5 & U6
  U7 -. "«extend»<br/>[non-2xx or timeout]" .-> U6
  Admin --- U8
  U9 -. "«extend»" .-> U8

  U4 -. "customer booking" .-> Customer
  U4 -. "merchant booking" .-> Recipient
  U5 -. "always" .-> Recipient
  U6 -. "POST" .-> Store
